# Make your own private secret (32–256 printable ASCII characters; no spaces).
# Set the same value ONLY in Railway and the portal's SERVER-side secret store.
SCRAPER_SHARED_SECRET=

# Local Mac only: shows Chromium. Railway/Render MUST use HEADLESS=true.
HEADLESS=false
PORT=5174

# Staff credentials are request-only. These empty placeholders are NOT loaded.
FITLER_EMAIL=
FITLER_PASSWORD=

# Optional settings. Safe defaults shown; no scheduler is included.
SCRAPE_TIMEOUT_MS=270000
MAX_EVENTS=500
MIN_SCRAPE_INTERVAL_MS=30000
CHROMIUM_SANDBOX=true
